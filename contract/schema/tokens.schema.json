{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Design Tokens",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": {
      "type": "object",
      "properties": {
        "$value": { "type": "string" },
        "$type": { "type": "string", "enum": ["color", "dimension"] }
      },
      "required": ["$value", "$type"],
      "additionalProperties": false
    }
  }
}
